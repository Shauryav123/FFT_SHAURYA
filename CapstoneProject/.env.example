# Decision Duel Environment Template
# Copy this file to .env and insert your real Firebase project credentials.
# Retrieve from Firebase Console: Project Settings > General > Your Apps > Web app (npm/SDK)
# And: Build > Realtime Database > Copy Data URL (ends in .firebaseio.com)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=https://<your-project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
